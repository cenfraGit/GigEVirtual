<?xml version="1.0" encoding="utf-8"?>
<RegisterDescription
    xmlns="http://www.genicam.org/GenApi/Version_1_1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.genicam.org/GenApi/Version_1_1 http://www.genicam.org/GenApi/GenApiSchema_Version_1_1.xsd"
    ModelName="MODEL"
    VendorName="VIRTUAL"
    ToolTip="Minimal simulated GigE Vision camera"
    StandardNameSpace="None"
    SchemaMajorVersion="1"
    SchemaMinorVersion="1"
    SchemaSubMinorVersion="0"
    MajorVersion="1"
    MinorVersion="0"
    SubMinorVersion="0"
    ProductGuid="9c6f6a2e-1b34-4a4f-8b6a-000000000001"
    VersionGuid="9c6f6a2e-1b34-4a4f-8b6a-000000000002">

	<Category Name="Root" NameSpace="Standard">
		<Description>Root of the simulated camera's feature tree.</Description>
		<Visibility>Beginner</Visibility>
		<pFeature>ImageFormatControl</pFeature>
		<pFeature>AcquisitionControl</pFeature>
		<pFeature>PayloadSize</pFeature>
	</Category>

	<Category Name="ImageFormatControl">
		<Description>Controls the format of the image being streamed.</Description>
		<Visibility>Beginner</Visibility>
		<pFeature>Width</pFeature>
		<pFeature>Height</pFeature>
		<pFeature>PixelFormat</pFeature>
	</Category>

	<Category Name="AcquisitionControl">
		<Description>Controls image acquisition.</Description>
		<Visibility>Beginner</Visibility>
		<pFeature>AcquisitionMode</pFeature>
		<pFeature>AcquisitionStart</pFeature>
		<pFeature>AcquisitionStop</pFeature>
	</Category>

	<Integer Name="Width" NameSpace="Standard">
		<Description>Width of the image in pixels.</Description>
		<Visibility>Beginner</Visibility>
		<pValue>WidthReg</pValue>
		<Min>64</Min>
		<Max>1920</Max>
		<Inc>4</Inc>
	</Integer>

	<IntReg Name="WidthReg">
		<Visibility>Invisible</Visibility>
		<Address>0xA000</Address>
		<Length>4</Length>
		<AccessMode>RW</AccessMode>
		<pPort>Device</pPort>
		<Sign>Unsigned</Sign>
		<Endianess>BigEndian</Endianess>
	</IntReg>

	<IntReg Name="Height">
		<Description>Height of the image in pixels.</Description>
		<Visibility>Beginner</Visibility>
		<Address>0xA004</Address>
		<Length>4</Length>
		<AccessMode>RW</AccessMode>
		<pPort>Device</pPort>
		<Sign>Unsigned</Sign>
		<Endianess>BigEndian</Endianess>
	</IntReg>

	<Enumeration Name="PixelFormat" NameSpace="Standard">
		<Description>Pixel format of the streamed image.</Description>
		<Visibility>Beginner</Visibility>
		<EnumEntry Name="Mono8" NameSpace="Standard">
			<Description>Mono8: Monochrome 8-Bit</Description>
			<Value>0x01080001</Value>
		</EnumEntry>
		<EnumEntry Name="Mono10" NameSpace="Standard">
			<Description>Mono10: Monochrome 10-Bit unpacked</Description>
			<Value>0x01100003</Value>
		</EnumEntry>
		<EnumEntry Name="Mono12" NameSpace="Standard">
			<Description>Mono12: Monochrome 12-Bit unpacked</Description>
			<Value>0x01100005</Value>
		</EnumEntry>
		<EnumEntry Name="Mono16" NameSpace="Standard">
			<Description>Mono16: Monochrome 16-Bit</Description>
			<Value>0x01100007</Value>
		</EnumEntry>
		<EnumEntry Name="BayerGR8" NameSpace="Standard">
			<Description>BayerGR8: 8-Bit Bayer GRBG</Description>
			<Value>0x01080008</Value>
		</EnumEntry>
		<EnumEntry Name="BayerRG8" NameSpace="Standard">
			<Description>BayerRG8: 8-Bit Bayer RGGB</Description>
			<Value>0x01080009</Value>
		</EnumEntry>
		<EnumEntry Name="BayerGB8" NameSpace="Standard">
			<Description>BayerGB8: 8-Bit Bayer GBRG</Description>
			<Value>0x0108000A</Value>
		</EnumEntry>
		<EnumEntry Name="BayerBG8" NameSpace="Standard">
			<Description>BayerBG8: 8-Bit Bayer BGGR</Description>
			<Value>0x0108000B</Value>
		</EnumEntry>
		<EnumEntry Name="BayerGR10" NameSpace="Standard">
			<Description>BayerGR10: 10-Bit Bayer GRBG unpacked</Description>
			<Value>0x0110000C</Value>
		</EnumEntry>
		<EnumEntry Name="BayerRG10" NameSpace="Standard">
			<Description>BayerRG10: 10-Bit Bayer RGGB unpacked</Description>
			<Value>0x0110000D</Value>
		</EnumEntry>
		<EnumEntry Name="BayerGB10" NameSpace="Standard">
			<Description>BayerGB10: 10-Bit Bayer GBRG unpacked</Description>
			<Value>0x0110000E</Value>
		</EnumEntry>
		<EnumEntry Name="BayerBG10" NameSpace="Standard">
			<Description>BayerBG10: 10-Bit Bayer BGGR unpacked</Description>
			<Value>0x0110000F</Value>
		</EnumEntry>
		<EnumEntry Name="BayerGR12" NameSpace="Standard">
			<Description>BayerGR12: 12-Bit Bayer GRBG unpacked</Description>
			<Value>0x01100010</Value>
		</EnumEntry>
		<EnumEntry Name="BayerRG12" NameSpace="Standard">
			<Description>BayerRG12: 12-Bit Bayer RGGB unpacked</Description>
			<Value>0x01100011</Value>
		</EnumEntry>
		<EnumEntry Name="BayerGB12" NameSpace="Standard">
			<Description>BayerGB12: 12-Bit Bayer GBRG unpacked</Description>
			<Value>0x01100012</Value>
		</EnumEntry>
		<EnumEntry Name="BayerBG12" NameSpace="Standard">
			<Description>BayerBG12: 12-Bit Bayer BGGR unpacked</Description>
			<Value>0x01100013</Value>
		</EnumEntry>
		<EnumEntry Name="RGB8" NameSpace="Standard">
			<Description>RGB8: 8-Bit RGB</Description>
			<Value>0x02180014</Value>
		</EnumEntry>
		<pValue>PixelFormatReg</pValue>
	</Enumeration>

	<IntReg Name="PixelFormatReg">
		<Visibility>Invisible</Visibility>
		<Address>0xA008</Address>
		<Length>4</Length>
		<AccessMode>RW</AccessMode>
		<pPort>Device</pPort>
		<Sign>Unsigned</Sign>
		<Endianess>BigEndian</Endianess>
	</IntReg>

	<Enumeration Name="AcquisitionMode" NameSpace="Standard">
		<Description>Acquisition mode of the device.</Description>
		<Visibility>Beginner</Visibility>
		<EnumEntry Name="Continuous" NameSpace="Standard">
			<Description>Frames are captured continuously until AcquisitionStop.</Description>
			<Value>0</Value>
		</EnumEntry>
		<pValue>AcquisitionModeReg</pValue>
	</Enumeration>

	<IntReg Name="AcquisitionModeReg">
		<Visibility>Invisible</Visibility>
		<Address>0xA014</Address>
		<Length>4</Length>
		<AccessMode>RW</AccessMode>
		<pPort>Device</pPort>
		<Sign>Unsigned</Sign>
		<Endianess>BigEndian</Endianess>
	</IntReg>

	<Command Name="AcquisitionStart" NameSpace="Standard">
		<Description>Starts image acquisition/streaming.</Description>
		<Visibility>Beginner</Visibility>
		<pValue>AcquisitionStartReg</pValue>
		<CommandValue>1</CommandValue>
	</Command>

	<IntReg Name="AcquisitionStartReg">
		<Visibility>Invisible</Visibility>
		<Address>0xA00C</Address>
		<Length>4</Length>
		<AccessMode>RW</AccessMode>
		<pPort>Device</pPort>
		<Sign>Unsigned</Sign>
		<Endianess>BigEndian</Endianess>
	</IntReg>

	<Command Name="AcquisitionStop" NameSpace="Standard">
		<Description>Stops image acquisition/streaming.</Description>
		<Visibility>Beginner</Visibility>
		<pValue>AcquisitionStopReg</pValue>
		<CommandValue>1</CommandValue>
	</Command>

	<IntReg Name="AcquisitionStopReg">
		<Visibility>Invisible</Visibility>
		<Address>0xA010</Address>
		<Length>4</Length>
		<AccessMode>RW</AccessMode>
		<pPort>Device</pPort>
		<Sign>Unsigned</Sign>
		<Endianess>BigEndian</Endianess>
	</IntReg>

	<IntReg Name="PayloadSizeVal">
		<Description>Payload size in bytes, as computed by the device.</Description>
		<Visibility>Invisible</Visibility>
		<Address>0x0D38</Address>
		<Length>4</Length>
		<AccessMode>RO</AccessMode>
		<pPort>Device</pPort>
		<Sign>Unsigned</Sign>
		<Endianess>BigEndian</Endianess>
	</IntReg>

	<Integer Name="PayloadSize" NameSpace="Standard">
		<Description>Number of bytes transferred for each image block.</Description>
		<Visibility>Beginner</Visibility>
		<pValue>PayloadSizeVal</pValue>
	</Integer>

	<Port Name="Device">
		<Description>Represents the physical GVCP register access mechanism.</Description>
		<Visibility>Invisible</Visibility>
	</Port>

</RegisterDescription>