<?xml version="1.0" encoding="utf-8"?>
<RegisterDescription
    xmlns="http://www.genicam.org/GenApi/Version_1_1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.genicam.org/GenApi/Version_1_1 http://www.genicam.org/GenApi/GenApiSchema_Version_1_1.xsd"
    ModelName="MODEL"
    VendorName="VIRTUAL"
    ToolTip="Minimal simulated GigE Vision camera"
    StandardNameSpace="None"
    SchemaMajorVersion="1"
    SchemaMinorVersion="1"
    SchemaSubMinorVersion="0"
    MajorVersion="1"
    MinorVersion="0"
    SubMinorVersion="0"
    ProductGuid="9c6f6a2e-1b34-4a4f-8b6a-000000000001"
    VersionGuid="9c6f6a2e-1b34-4a4f-8b6a-000000000002">

	<Category Name="Root" NameSpace="Standard">
		<Description>Root of the simulated camera's feature tree.</Description>
		<Visibility>Beginner</Visibility>
		<pFeature>ImageFormatControl</pFeature>
		<pFeature>AcquisitionControl</pFeature>
		<pFeature>PayloadSize</pFeature>
	</Category>

	<Category Name="ImageFormatControl">
		<Description>Controls the format of the image being streamed.</Description>
		<Visibility>Beginner</Visibility>
		<pFeature>Width</pFeature>
		<pFeature>Height</pFeature>
		<pFeature>PixelFormat</pFeature>
	</Category>

	<Category Name="AcquisitionControl">
		<Description>Controls image acquisition.</Description>
		<Visibility>Beginner</Visibility>
		<pFeature>AcquisitionMode</pFeature>
		<pFeature>AcquisitionStart</pFeature>
		<pFeature>AcquisitionStop</pFeature>
	</Category>

	<Integer Name="Width" NameSpace="Standard">
		<Description>Width of the image in pixels.</Description>
		<Visibility>Beginner</Visibility>
		<pValue>WidthReg</pValue>
		<Min>64</Min>
		<Max>1920</Max>
		<Inc>4</Inc>
	</Integer>

	<IntReg Name="WidthReg">
		<Visibility>Invisible</Visibility>
		<Address>0xA000</Address>
		<Length>4</Length>
		<AccessMode>RW</AccessMode>
		<pPort>Device</pPort>
		<Sign>Unsigned</Sign>
		<Endianess>BigEndian</Endianess>
	</IntReg>

	<IntReg Name="Height">
		<Description>Height of the image in pixels.</Description>
		<Visibility>Beginner</Visibility>
		<Address>0xA004</Address>
		<Length>4</Length>
		<AccessMode>RW</AccessMode>
		<pPort>Device</pPort>
		<Sign>Unsigned</Sign>
		<Endianess>BigEndian</Endianess>
	</IntReg>

	<Enumeration Name="PixelFormat" NameSpace="Standard">
		<Description>Pixel format of the streamed image.</Description>
		<Visibility>Beginner</Visibility>
		<EnumEntry Name="Mono8" NameSpace="Standard">
			<Description>Mono8: Monochrome 8-Bit</Description>
			<Value>0x01080001</Value>
		</EnumEntry>
		<pValue>PixelFormatReg</pValue>
	</Enumeration>

	<IntReg Name="PixelFormatReg">
		<Visibility>Invisible</Visibility>
		<Address>0xA008</Address>
		<Length>4</Length>
		<AccessMode>RW</AccessMode>
		<pPort>Device</pPort>
		<Sign>Unsigned</Sign>
		<Endianess>BigEndian</Endianess>
	</IntReg>

	<Enumeration Name="AcquisitionMode" NameSpace="Standard">
		<Description>Acquisition mode of the device.</Description>
		<Visibility>Beginner</Visibility>
		<EnumEntry Name="Continuous" NameSpace="Standard">
			<Description>Frames are captured continuously until AcquisitionStop.</Description>
			<Value>0</Value>
		</EnumEntry>
		<pValue>AcquisitionModeReg</pValue>
	</Enumeration>

	<IntReg Name="AcquisitionModeReg">
		<Visibility>Invisible</Visibility>
		<Address>0xA014</Address>
		<Length>4</Length>
		<AccessMode>RW</AccessMode>
		<pPort>Device</pPort>
		<Sign>Unsigned</Sign>
		<Endianess>BigEndian</Endianess>
	</IntReg>

	<Command Name="AcquisitionStart" NameSpace="Standard">
		<Description>Starts image acquisition/streaming.</Description>
		<Visibility>Beginner</Visibility>
		<pValue>AcquisitionStartReg</pValue>
		<CommandValue>1</CommandValue>
	</Command>

	<IntReg Name="AcquisitionStartReg">
		<Visibility>Invisible</Visibility>
		<Address>0xA00C</Address>
		<Length>4</Length>
		<AccessMode>RW</AccessMode>
		<pPort>Device</pPort>
		<Sign>Unsigned</Sign>
		<Endianess>BigEndian</Endianess>
	</IntReg>

	<Command Name="AcquisitionStop" NameSpace="Standard">
		<Description>Stops image acquisition/streaming.</Description>
		<Visibility>Beginner</Visibility>
		<pValue>AcquisitionStopReg</pValue>
		<CommandValue>1</CommandValue>
	</Command>

	<IntReg Name="AcquisitionStopReg">
		<Visibility>Invisible</Visibility>
		<Address>0xA010</Address>
		<Length>4</Length>
		<AccessMode>RW</AccessMode>
		<pPort>Device</pPort>
		<Sign>Unsigned</Sign>
		<Endianess>BigEndian</Endianess>
	</IntReg>

	<IntSwissKnife Name="PayloadSizeVal">
		<pVariable Name="WIDTH">Width</pVariable>
		<pVariable Name="HEIGHT">Height</pVariable>
		<Formula>WIDTH * HEIGHT</Formula>
	</IntSwissKnife>

	<Integer Name="PayloadSize" NameSpace="Standard">
		<Description>Number of bytes transferred for each image block.</Description>
		<Visibility>Beginner</Visibility>
		<pValue>PayloadSizeVal</pValue>
	</Integer>

	<Port Name="Device">
		<Description>Represents the physical GVCP register access mechanism.</Description>
		<Visibility>Invisible</Visibility>
	</Port>

</RegisterDescription>